<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/productListFragment">
    <fragment
        android:id="@+id/productListFragment"
        android:name="com.example.shopapp.ui.fragment.product_list.ProductListFragment"
        android:label="fragment_product_list"
        tools:layout="@layout/fragment_product_list">
        <action
            android:id="@+id/action_productListFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_productListFragment_to_productCartFragment"
            app:destination="@id/productCartFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.example.shopapp.ui.fragment.product_details.ProductDetailsFragment"
        android:label="fragment_product_ditails"
        tools:layout="@layout/fragment_product_details">

        <argument
            android:name="productId"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/productCartFragment"
        android:name="com.example.shopapp.ui.fragment.product_cart.ProductCartFragment"
        android:label="ProductCartFragment"
        tools:layout="@layout/fragment_product_cart"/>


</navigation>